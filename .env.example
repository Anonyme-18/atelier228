# Neon PostgreSQL Database
# Get your connection string from: https://console.neon.tech
VITE_NEON_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Admin Access (change this in production!)
VITE_ADMIN_CODE=2280

# Optional: Analytics
# VITE_GA_ID=G-XXXXXXXXXX

# Optional: Email notifications
# VITE_EMAIL_SERVICE=smtp
# VITE_EMAIL_HOST=smtp.gmail.com
# VITE_EMAIL_PORT=587
# VITE_EMAIL_USER=your-email@gmail.com
# VITE_EMAIL_PASSWORD=your-app-password
